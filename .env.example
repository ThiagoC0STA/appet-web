# Copie para .env.local e preencha. Nunca versione o .env.local.
#
# Estas duas variáveis NÃO levam o prefixo NEXT_PUBLIC_ de propósito:
# com ele, o Next as embutiria no bundle do navegador, e a chave de
# service role ignora o RLS inteiro. Ela só pode existir no servidor.
#
# Onde achar: painel do Supabase, Project Settings > API.

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole-a-service-role-key-aqui
